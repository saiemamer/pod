+
+  it('creates a worker worktree in a named repo under a folder-workspace coordinator', async () => {
+    coordinateFromFolderWorkspace()
+    mockCreatedWorktree()
+
+    const { result } = await startWorker({ worktree: 'new-child', repo: 'id:repo' })
